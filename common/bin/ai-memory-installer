#!/bin/bash

mkdir -p ~/.local/bin

tmp="$(mktemp -d)"
base=https://github.com/akitaonrails/ai-memory/releases/latest/download/ai-memory-wrapper

curl -fsSL "$base" -o "$tmp/ai-memory-wrapper"
curl -fsSL "$base.sha256" -o "$tmp/ai-memory-wrapper.sha256"

expected="$(awk 'NR == 1 { print $1 }' "$tmp/ai-memory-wrapper.sha256")"
actual="$(sha256sum "$tmp/ai-memory-wrapper" | awk '{ print $1 }')"

[ "$actual" = "$expected" ] || {
  echo "checksum mismatch"
  exit 1
}

install -m 0755 "$tmp/ai-memory-wrapper" ~/.local/bin/ai-memory
rm -r "$tmp"
